@inject NavigationManager Navigation

<div class="container border border-info m-1 bg-secondary bg-opacity-10">
    <div class="row m-2">
        <div class="col m-2">
            <span>
                @if (Comment.AppUser != null && Comment.AppUser.AppUserOptional != null && !string.IsNullOrEmpty(Comment.AppUser.AppUserOptional.ProfilePictureURL))
                {
                    <img class="m-2" src="@($"{Constants.HostAddress}/{Comment.AppUser.AppUserOptional.ProfilePictureURL}")" alt="User Icon" />
                }
                else
                {
                    <img class="m-2" src="@GetUserProfileIcon(Comment.AppUser?.IsMale ?? true)" alt="User Icon" />
                }             
                <label class="text-black">
                    @(Comment.AppUser?.DisplayName ?? "Debug: appuser displayName is null")
                </label>
                <a class="text-info m-2" @onclick="@(() => Navigation.NavigateTo($"user/details/{Comment.AppUserId}"))">user details</a>
                <a class="text-info m-2" @onclick="@(() => Navigation.NavigateTo($"comment/details/{Comment.CommentId}"))">comment details</a>
                <a class="text-info m-2" @onclick="@(() => Navigation.NavigateTo($"blog/details/{Comment.BlogId}"))">blog details</a>
            </span>
        </div>
    </div>
    <div class="row m-2">
        <div class="col">
            <textarea disabled class="form-control-plaintext input-group-text text-start" @bind="@Comment.StringContent"></textarea>
        </div>
    </div>
    <div class="row m-2">
        <div class="col">
            <span class="text-success">
                <img src="@(GetFaceEmojiIcon(true))" />
                <label>@Comment.Like</label>
            </span>

        </div>
        <div class="col">
            <span class="text-danger">
                <img src="@(GetFaceEmojiIcon(false))" />
                <label>@Comment.Dislike</label>
            </span>
        </div>
    </div>
</div>
@code
{
    [Parameter, EditorRequired]
    public Comment Comment { get; set; }

    private static string s_HappyFaceIcon = $"{Constants.HostAddress}/{Constants.StaticImagesURL.FaceHappyIcon}";
    private static string s_UnhappyFaceIcon = $"{Constants.HostAddress}/{Constants.StaticImagesURL.FaceUnhappyIcon}";
    private static string s_MaleIcon = $"{Constants.HostAddress}/{Constants.StaticImagesURL.MaleUserProfileIcon}";
    private static string s_FemaleIcon = $"{Constants.HostAddress}/{Constants.StaticImagesURL.FemaleUserProfileIcon}";

    public string GetFaceEmojiIcon(bool isHappy)
    {       
        return isHappy ? s_HappyFaceIcon : s_UnhappyFaceIcon;
    }

    public string GetUserProfileIcon(bool isMale)
    {
        if (isMale) return s_MaleIcon;
        else return s_FemaleIcon;
    }
}
