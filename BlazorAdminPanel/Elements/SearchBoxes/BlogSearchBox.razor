<div class="m-2 container bg-secondary bg-opacity-25 border border-2 border-warning">
    <div class="m-2 row">
        <div class="m-2 col">
            <h3 class="m-2 alert alert-info text-center">Advance Search</h3>
        </div>
    </div>
    <div class="m-2 row">
        <div class="col">
            <EditForm Model="SearchModel" OnSubmit="ClickHandler" id="form">
                <span>
                    <div class="m-3">
                        BlogId <InputNumber class="m-1" @bind-Value="SearchModel.BlogId" />
                    </div>
                    <div class="m-3">
                        UserId <InputNumber class="m-1" @bind-Value="SearchModel.AppUserId" /> (user who own this)
                    </div>
                    <div class="m-3">
                        Title <InputText class="m-1" @bind-Value="SearchModel.Title" />
                    </div>
                    <div class="m-3">
                        Content <InputText class="m-1" @bind-Value="SearchModel.Content" />
                    </div>
                    <div class="m-3">
                        Confirmed <InputSelect class="m-1" TValue="Confirm" @bind-Value="@_confirm">
                                      <option value="All">All</option>
                                      <option value="Yes">Yes</option>
                                      <option value="No">No</option>                           
                                  </InputSelect>
                    </div>
                    <div class="m-3">
                        AccessType <InputSelect class="m-1" TValue="AccessType" @bind-Value="@_accessType">
                            <option value="All">All</option>
                            <option value="Public">Public</option>
                            <option value="Private">Private</option>
                        </InputSelect>
                    </div>                  
                    <div class="m-3">
                        Skip <InputNumber class="m-1" @bind-Value="SearchModel.Skip" />
                    </div>
                    <div class="m-3">
                        Take <InputNumber class="m-1" @bind-Value="SearchModel.Take" />
                    </div>
                </span>
            </EditForm>
        </div>
    </div>
    <div class="row align-items-center m-2">
        <div class="col-4">+ After search, use pagination to view results.</div>
        <div class="col m-2">
            <button class="m-2 btn btn-outline-danger" @onclick="()=>SearchModel = new()">Clear all filters</button>
            <button form="form" type="submit" class="m-2 btn btn-outline-success">Search</button>
        </div>
        <div class="col-4"></div>
    </div>
</div>

@code
{
    public enum Confirm
    {
        All,
        Yes,
        No
    }

    public enum AccessType
    {
        All,
        Public,
        Private
    }

    [Parameter]
    public EventCallback<BlogSearch> OnClick { get; set; }

    public BlogSearch SearchModel { get; set; } = new();

    private Confirm _confirm = Confirm.All;
    private AccessType _accessType = AccessType.All;

    public void ClickHandler()
    {
        // if string is empty turn them to null:
        if (string.IsNullOrEmpty(SearchModel.Title)) SearchModel.Title = null;
        if (string.IsNullOrEmpty(SearchModel.Content)) SearchModel.Content = null;

        SearchModel.IsConfirmed = _confirm switch
        {
            Confirm.All => null,
            Confirm.Yes => true,
            Confirm.No => false,
            _ => null,
        };
        SearchModel.IsPublic = _accessType switch
        {
            AccessType.All => null,
            AccessType.Public => true,
            AccessType.Private => false,
            _ => null,
        };

        OnClick.InvokeAsync(SearchModel);
    }
}