@typeparam T 

<div class="m-2 container">
    <div class="m-2 row bg-secondary bg-opacity-25 border border-2 border-warning">
        <div class="col-11">
            @ChildContent
        </div>
        <div class="col-1">
            <button class="m-2 btn btn-outline-light" @onclick="() => ClickHandler()">Search</button>
        </div>
    </div>
</div>

@code
{
    public T SearchModel { get; set; } = new T();

    [Parameter]
    public EventCallback<T> OnClick { get; set; }

    public virtual void ClickHandler() {  }

    protected virtual RenderFragment? ChildContent { get; set; }

}