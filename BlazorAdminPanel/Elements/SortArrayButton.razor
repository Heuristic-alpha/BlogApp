@typeparam TItem
@typeparam TProperty

<button class="btn m-1" @onclick="OnClick">
    <span>
        <b>
            @ChildContent
        </b>
        <img class="m-1" alt="small-arrow" src="@GetImageSource()" width="16" height="16"/>
    </span>  
</button>


@code {

    [Parameter, EditorRequired]
    public TItem[] Values { get; set; }
    [Parameter, EditorRequired]
    public EventCallback<TItem[]> ValuesChanged { get; set; }

    [Parameter,EditorRequired]
    public Func<TItem, TProperty> Selector { get; set; }

    [Parameter]
    public IComparer<TProperty>? Comparer { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private bool _IsAcending = true;

    private void OnClick()
    {
        _IsAcending = !_IsAcending;

        if (_IsAcending)
        {           
            Values = Comparer != null ? Values.OrderBy(Selector, Comparer).ToArray() : Values.OrderBy(Selector).ToArray();
        }
        else
        {
            Values = Comparer != null ? Values.OrderByDescending(Selector, Comparer).ToArray() : Values.OrderByDescending(Selector).ToArray();
        }
        ValuesChanged.InvokeAsync(Values);
    }

    private string GetTextColor()
    {
        if (_IsAcending) return "text-success";
        else return "text-danger";
    }

    private static string s_UpArrowURL = $"{Constants.HostAddress}/{Constants.StaticImagesURL.SmallArrowUpIcon}";
    private static string s_DownArrowURL = $"{Constants.HostAddress}/{Constants.StaticImagesURL.SmallArrowDownIcon}";

    private string GetImageSource()
    {
        if (_IsAcending) return s_DownArrowURL;
        else return s_UpArrowURL;
    }
}
