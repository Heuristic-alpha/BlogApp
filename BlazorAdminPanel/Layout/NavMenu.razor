@inject NavigationManager Navigation

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand text-info" @onclick="@(() => Navigation.NavigateTo(""))">Admin Panel</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <a class="nav-link" href="@Constants.HostAddress">
                <span class="fa fa-server"></span><p class="m-3">Site</p>
            </a>
        </div>
        <div class="nav-item px-3">
            <a class="nav-link" @onclick="@(() => Navigation.NavigateTo("database/statistic"))">
                <span class="fa fa-database"></span><p class="m-3">Database Statistic</p>
            </a>
        </div>
        <div class="nav-item px-3">
            <a class="nav-link" @onclick="@(() => Navigation.NavigateTo("user/list"))">
                <span class="fa fa-people-arrows"></span><p class="m-3">Users list</p>
            </a>
        </div>
        <div class="nav-item px-3">
            <a class="nav-link" @onclick="@(() => Navigation.NavigateTo("blog/list"))">
                <span class="fa fa-blog"></span><p class="m-3">Blogs list</p>
            </a>
        </div>
        <div class="nav-item px-3">
            <a class="nav-link" @onclick="@(() => Navigation.NavigateTo("comment/list"))">
                <span class="fa fa-comment"></span><p class="m-3">Comments list</p>
            </a>
        </div>
        <div class="nav-item px-3">
            <a class="nav-link" @onclick="@(() => Navigation.NavigateTo("category/list"))">
                <span class="fa fa-tags"></span><p class="m-3">Categories list</p>
            </a>
        </div>
    </nav>
</div>

@code {
    [Inject]
    public HttpClient? Http { get; set; }

    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
