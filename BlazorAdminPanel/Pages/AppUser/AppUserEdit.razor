@page "/user/edit/{id:long}"
@page "/user/create"
@attribute [Authorize(Roles = Constants.Roles.Manager)]

@using BlazorAdminPanel
@using BlazorAdminPanel.Elements
@using BlazorAdminPanel.Gadgets
@using BlazorAdminPanel.Layout
@using BlazorAdminPanel.Services
@using BlogApp.Models
@using BlogApp.Models.DataModels
@using BlogApp.Models.Enums
@using BlogApp.Models.JoinModels
@using BlogApp.Services

@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime jSRuntime

<PageTitle>User @Mode.ToString()</PageTitle>
<h1 class="bg-warning text-black text-center">User @Mode.ToString()</h1>

<EditForm Model="@UserDetailsDto" OnValidSubmit="async () => await HandleSubmit()">
    <DataAnnotationsValidator />

    <div class="m-2 border border-2 border-info">
        <label class="form-label m-2">AppUserId</label>
        <InputNumber class="m-2 form-control" @bind-Value="@UserDetailsDto.AppUserId" readonly />
    </div>
    <div class="m-2 border border-2 border-info">
        <label class="form-label m-2">IdentityAppUserId</label>
        <InputText class="m-2 form-control" @bind-Value="@UserDetailsDto.IdentityAppUserId" readonly />
    </div>
    <div class="m-2 border border-2 border-info">
        <label class="form-label m-2">Email</label>     
        <span>
             <ValidationMessage For="() => UserDetailsDto.Email" />
        </span>
        <InputText class="m-2 form-control" @bind-Value="@UserDetailsDto.Email"/>             
    </div>
    <div class="m-2 border border-2 border-info">
        <span>
            <label class="form-label m-2">UserName</label>
            <ValidationMessage For="() => UserDetailsDto.UserName" />
        </span>
        <InputText class="form-control m-2" @bind-Value="@UserDetailsDto.UserName" />
    </div>
    @if (Mode == ActionMode.Create)
    {
        <div class="m-2 border border-2 border-info">
            <span>
                <label class="form-label m-2">Password</label>
                <ValidationMessage For="() => UserDetailsDto.Password" />
            </span>
            <InputText class="form-control text-danger m-2" @bind-Value="@UserDetailsDto.Password" />
        </div>
    }
    <div class="m-2 border border-2 border-info">
        <span>
            <label class="form-label m-2">Description</label>
            <ValidationMessage For="() => UserDetailsDto.Description" />
        </span>
        <InputTextArea class="form-control m-2" @bind-Value="@UserDetailsDto.Description" />
    </div>
    <div class="m-2 border border-2 border-info">
        <label class="form-label m-2">Gender</label>
        <InputSelect class="form-select m-2" TValue="bool" @bind-Value="@UserDetailsDto.IsMale">
            <ChildContent>
                <option value="true">Male</option>
                <option value="false">Female</option>
            </ChildContent>
        </InputSelect>
    </div>
    <div class="m-2 border border-2 border-info">
        <label class="form-label m-2">Creation Date</label>
        <ValidationMessage For="() => UserDetailsDto.CreationDateTime" />
        <InputDate class="form-control m-2" @bind-Value="@UserDetailsDto.CreationDateTime" readonly />
    </div>
    <div class="m-2 border border-2 border-info">
        <label class="form-label m-2">Roles:</label>
        @if(UserDetailsDto.RolesDict != null)
        {
            @foreach (KeyValuePair<string,bool> keyValuePair in UserDetailsDto.RolesDict)
            {
                string key = keyValuePair.Key;
                bool val = keyValuePair.Value;
                <div class="m-2">
                    <span>
                        <label class="form-label text-secondary">@key</label>                        
                        <input type="checkbox" class="valid" checked="@val" @onchange="@(async (ChangeEventArgs e) => 
                              {
                                  bool? boolVal = (bool)e.Value!;
                                  if(boolVal != null) UserDetailsDto.RolesDict[key] = boolVal.Value;
                               // await jSRuntime.InvokeVoidAsync("console.log", $"Current dict state: ({key}) : ({UserDetailsDto.RolesDict[key]})");
                              })" />
                    </span>
                </div>
                
            }
        }       
    </div>
    
    <div class="form-group m-5">
        @if (Mode == ActionMode.Create)
        {
            <button type="submit" class="btn btn-primary">@Mode.ToString()</button>
        }
        else if (Mode == ActionMode.Update)
        {
            <button type="submit" class="btn btn-warning">@Mode.ToString()</button>
        }
    </div>
</EditForm>

@code
{
    [Parameter]
    public long Id { get; set; }

    public UserDetailsDto UserDetailsDto { get; set; } = new UserDetailsDto();

    public ActionMode Mode => Id == 0 ? ActionMode.Create : ActionMode.Update;

    protected override async Task OnParametersSetAsync()
    {
        ActionMode mode = Mode;
        if (mode == ActionMode.Update)
        {
            UserDetailsDto? udd = await Http.GetFromJsonAsync<UserDetailsDto>($"/api/AppUser/Get/{Id}");
            if (udd != null) UserDetailsDto = udd;
        }
        else if(mode == ActionMode.Create)
        { 
            // get empty roles dict ('0' route value is a api contract)
            UserDetailsDto.RolesDict = await Http.GetFromJsonAsync<Dictionary<string, bool>>($"/api/AppUser/GetIdentityRoles/0");
            UserDetailsDto.CreationDateTime = DateTime.Now;
        }
    }

    private async Task HandleSubmit()
    {
        if (Mode == ActionMode.Create)
        {
            var response = await Http.PostAsJsonAsync<UserDetailsDto>("/api/AppUser/Create", UserDetailsDto);
            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("user/list");
            }
            else
            {
                await jSRuntime.InvokeVoidAsync("alert", await response.Content.ReadAsStringAsync());
            }
        }
        else if (Mode == ActionMode.Update)
        {
            var response = await Http.PutAsJsonAsync<UserDetailsDto>("/api/AppUser/Update", UserDetailsDto);
            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("user/list");
            }
            else
            {
                await jSRuntime.InvokeVoidAsync("alert", await response.Content.ReadAsStringAsync());
            }
        }
    }
}