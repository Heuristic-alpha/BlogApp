@page "/database/statistic"
@attribute [Authorize(Roles = Constants.Roles.Admins)]

<PageTitle>Database Statistic</PageTitle>
<h1 class="bg-info text-black text-black text-center m-2">Database Statistic</h1>


<div class="container">
    <div class="row">
        <div class="col-12 col-md-12 col-lg-6 m-2">
            <table class="table table-bordered table-hover table-info bg-opacity-50">
                <thead>
                    <tr class="text-center">
                        <th>Table</th>
                        <th>Total Count</th>
                    </tr>
                </thead>
                <tbody>
                    <tr class="text-center">
                        <td>Identity Users</td>
                        <td>@dataBaseStatistic?.IdentityAppUserCount</td>
                    </tr>
                    <tr class="text-center">
                        <td>App Users</td>
                        <td>@dataBaseStatistic?.AppUsersCount</td>
                    </tr>
                    <tr class="text-center">
                        <td>AppUser Optionals</td>
                        <td>@dataBaseStatistic?.AppUserOptionalsCount</td>
                    </tr>
                    <tr class="text-center">
                        <td>Blogs</td>
                        <td>@dataBaseStatistic?.BlogsCount</td>
                    </tr>
                    <tr class="text-center">
                        <td>Comments</td>
                        <td>@dataBaseStatistic?.CommentsCount</td>
                    </tr>
                    <tr class="text-center">
                        <td>Categories</td>
                        <td>@dataBaseStatistic?.CategoriesCount</td>
                    </tr>
                    <tr class="text-center">
                        <td>AppUserComments</td>
                        <td>@dataBaseStatistic?.AppUserCommentsCount</td>
                    </tr>
                    <tr class="text-center">
                        <td>AppUserBlogs</td>
                        <td>@dataBaseStatistic?.AppUserBlogsCount</td>
                    </tr>
                    <tr class="text-center">
                        <td>BlogCategories</td>
                        <td>@dataBaseStatistic?.BlogCategoriesCount</td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="col-12 col-md-12 col-lg-12 m-2 bg-success bg-opacity-25 border border-2 border-success">
            <p class="m-2">- This project contains 2 Database: 1-<span class="text-danger">Identity DbContext</span> and 2-<span class="text-danger">Data DbContext</span> .</p>
            <p class="m-2">- <span class="text-danger">Identity DbContext</span> Contains information about users identities, also contains <span class="text-primary">Identity Users</span> .</p>
            <p class="m-2">- <span class="text-danger">Data DbContext</span> Contains all Application data, also contains <span class="text-primary">App Users</span> .</p>
            <p class="m-2">- Counts of <span class="text-primary">App Users</span> and <span class="text-primary">Identity Users</span> should be equal, if they are not then it is a problem. </p>
        </div>
        <div class="col-12 col-md-12 col-lg-12 m-2 bg-warning bg-opacity-25 border border-2 border-warning">
            <p class="m-2">- <span class="text-primary">Blogs</span> depend on AppUsers, if AppUser deleted, then Blogs that depend on that AppUser also will be deleted.</p>
            <p class="m-2">- <span class="text-primary">Comments</span> depend on AppUsers and Blogs, if AppUser or Blog deleted, then Comments that depend on that AppUser or Blog also will be deleted.</p>           
            <p class="m-2">- <span class="text-primary">AppUserComments</span> are joint table of AppUsers with Comments that depend on them, if AppUser or Comment deleted, then AppUserComments that depend on them also will be deleted.</p>
            <p class="m-2">- <span class="text-primary">AppUserComments</span> contains Comment votes </p>
            <p class="m-2">- <span class="text-primary">AppUserBlogs</span> are joint table of AppUsers with Blogs that depend on them, if AppUser or Blog deleted, then AppUserBlogs that depend on them also will be deleted.</p>
            <p class="m-2">- <span class="text-primary">AppUserBlogs</span> contains Blog votes </p>
            <p class="m-2">- <span class="text-primary">BlogCategories</span> are joint table of Blogs with Categories that depend on them, if Blog or Category deleted, then BlogCategories that depend on them also will be deleted.</p>
        </div>
    </div>  
</div>

@code
{
    [Inject]
    public HttpClient? Http { get; set; }

    public DataBaseStatisticDto? dataBaseStatistic { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await UpdateDataAsync();
    }

    private async Task UpdateDataAsync()
    {
        if (Http == null) return;
        dataBaseStatistic = await Http.GetFromJsonAsync<DataBaseStatisticDto>("/api/App/GetDatabaseStatistic");
    }
}
