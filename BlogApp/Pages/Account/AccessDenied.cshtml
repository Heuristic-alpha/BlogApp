@page
@{
    ViewBag.Title = "Access Denied";
    Layout = "_HomeLayout";
}

<h4 class="bg-danger text-white text-center p-2">Access Denied</h4>
<div class="m-2">
    <h6 class="text-center">You are not authorized for this URL</h6>
    <a class="btn btn-outline-danger" href="/">Home</a>
    <a class="btn btn-outline-secondary" asp-page="Logout">Logout</a>
</div>