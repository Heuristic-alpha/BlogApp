@page
@inject LocalManager LM
@{
    ViewBag.Title = "Account is created";
    Layout = "_HomeLayout";
    Language lang = Html.ViewContext.HttpContext.GetCurrentLanguage();   
}

<div class="container">
    <h1 class="bg-success text-light text-center">@LM.GetLocalOrKey("Congrats! your account created successfully", lang)</h1>
    <h4 class="bg-light text-black text-center">@LM.GetLocalOrKey("Now Login to your account using this button", lang):</h4>
   <div class="row m-4">
       <div class="col-5"></div>
        <div class="col"><a asp-page="/Account/Login" class="btn btn-success">@LM.GetLocalOrKey("Login", lang)</a></div>
       <div class="col-5"></div>
   </div> 
</div>