@page
@model BlogApp.Pages.Account.SignUpModel
@inject LocalManager LM
@{
    ViewBag.Title = "SignUp";
    Layout = "_HomeLayout";
    Language lang = Html.ViewContext.HttpContext.GetCurrentLanguage();   
}

<partial name="_JqueryValidation" />

<div class="container">
    <div class="row">
        <div class="col">
            <h1 class="bg-success text-light text-center m-3">
                @LM.GetLocalOrKey("SignUp", lang)
            </h1>
        </div>
    </div>
    <div class="row">
        <div class="col text-danger" asp-validation-summary="ModelOnly"></div>
    </div>
    <div class="row">
        <div class="col">
            <form method="post" asp-asp-page="SignUp" id="frm">
                <div class="col form-control m-1">
                    <label>@LM.GetLocalOrKey("UserName", lang)</label>
                    <span class="text-danger" asp-validation-for="@Model.UserName"></span>
                    <input class="input-group-text form-text" asp-for="@Model.UserName" />
                </div>
                <div class="col form-control m-1">
                    <label>@LM.GetLocalOrKey("Email", lang)</label>
                    <span class="text-danger" asp-validation-for="@Model.Email"></span>
                    <input class="input-group-text form-text" asp-for="@Model.Email" />
                </div>
                <div class="col form-control m-1">
                    <label>@LM.GetLocalOrKey("Password", lang)</label>
                    <span class="text-danger" asp-validation-for="@Model.Password"></span>
                    <input class="input-group-text form-text" asp-for="@Model.Password" />
                </div>
                <div class="col form-control m-1">
                    <label>@LM.GetLocalOrKey("Confirm Password", lang)</label>
                    <span class="text-danger" asp-validation-for="@Model.ConfirmPassword"></span>
                    <input class="input-group-text form-text" asp-for="@Model.ConfirmPassword" />
                </div>
                <div class="col form-control m-1">
                    <label>@LM.GetLocalOrKey("Gender", lang)</label>
                    <select class="form-select-sm" asp-for="@Model.IsMale" >
                        <option class="m-3" value="true">@LM.GetLocalOrKey("Male", lang)<img class="m-3" src="@Model.GetIconPath(true)" alt="Icon" width="16" height="16" /></option>
                        <option class="m-3" value="false">@LM.GetLocalOrKey("Female", lang)<img class="m-3" src="@Model.GetIconPath(false)" alt="Icon" width="16" height="16" /></option>
                    </select>
                </div>
            </form>
        </div>
    </div>
    <div class="row m-2">
        <div class="col-2 btn-group">
            <button type="submit" class="btn  btn-outline-success" form="frm">@LM.GetLocalOrKey("Make", lang)</button>
        </div>
    </div>
</div>                       