@page
@model BlogApp.Pages.DashboardModel
@inject LocalManager LM
@{
    ViewBag.Title = "Dashboard";
    Layout = "_HomeLayout";
    Language lang = Html.ViewContext.HttpContext.GetCurrentLanguage();
}

<div class="m-2 border border-5 border-secondary">
    <h2 class="m-2 bg-secondary bg-opacity-50 text-black text-center">@LM.GetLocalOrKey("Profile",lang)
        <span class="m-1"><span class="fa fa-user-alt"></span></span>
    </h2>
    <div class="m-2 bg-primary bg-opacity-25">
        <div class="m-2 border border-1 border-dark">
            <span class="m-2">
                <label class="m-2">@LM.GetLocalOrKey("UserName", lang):</label>
                <input type="text" class="input-group-text form-text m-2" name="userName" value="@Model.IdentityAppUser!.UserName" readonly />
            </span>
        </div>
        <div class="m-2 border border-1 border-dark">
            <span class="m-2">
                <label class="m-2">@LM.GetLocalOrKey("Email", lang):</label>
                <input type="text" class="input-group-text form-text m-2" name="email" value="@Model.IdentityAppUser!.Email" readonly />
            </span>
        </div>
        <div class="m-2 border border-1 border-dark">
            <span class="m-2">
                <label class="m-2">@LM.GetLocalOrKey("Description", lang):</label>
                <input type="text" class="m-2 form-control-plaintext input-group-text text-start" name="description" value="@Model.AppUser!.Description" readonly />
            </span>
        </div>
        <a asp-page="/Account/Logout" class="btn btn-danger m-2">@LM.GetLocalOrKey("Logout", lang)</a>
        <a asp-page="/Profile/Edit" class="btn btn-warning m-2">@LM.GetLocalOrKey("Edit", lang)</a>
    </div>
</div>
<div class="m-5">
    @*Blank*@
</div>
<div class="m-5">
    @*Blank*@
</div>
<div class="m-2 border border-5 border-secondary">
    <h2 class="m-2 bg-secondary bg-opacity-50 text-black text-center">
        @LM.GetLocalOrKey("Blogs", lang)
        <span class="m-1"><span class="fa fa-blog"></span></span>
    </h2>
    <div class="m-2 bg-primary bg-opacity-25">
        <div class="m-2">
            <span class="m-2">
                <a asp-controller="BlogEdit" asp-Action="Index" class="btn btn-warning m-4">@LM.GetLocalOrKey("See", lang) @LM.GetLocalOrKey("Details", lang)</a>
                <a asp-page="/Dashboard" asp-route-canShowBlogs="true" class="btn btn-info m-4">@LM.GetLocalOrKey("Blogs", lang)</a>
            </span>
            @if (Model.CanShowBlogs)
            {
                @if (Model.UserBlogs.Any())
                {
                    <div class="m-2">
                        @for (int i = 0; i < Model.UserBlogs.Length; i++)
                        {
                            int curentI = i;
                            Blog blog = Model.UserBlogs[curentI];

                            <div class="m-2 bg-warning bg-opacity-25 border border-2 border-success">
                                <h2 class="m-2 text-black text-center bg-danger bg-opacity-50">@LM.GetLocalOrKey("Blog", lang) #@(i + 1)</h2>
                                <vc:render-blog blog="@blog" />
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="m-2 text-warning">You dont have any blog yet.</p>
                }
            }

        </div>
    </div>
</div>
<div class="m-5">
    @*Blank*@
</div>
<div class="m-5">
    @*Blank*@
</div>
<div class="m-2 border border-5 border-secondary">
    <h2 class="m-2 bg-secondary bg-opacity-50 text-black text-center">
        @LM.GetLocalOrKey("Comments", lang)
        <span class="m-1"><span class="fa fa-comment"></span></span>
    </h2>
    <div class="m-2 bg-primary bg-opacity-25">
        <div class="m-2">
            <span class="m-2">
                <a asp-controller="CommentOperation" asp-Action="Index" class="btn btn-warning m-4">@LM.GetLocalOrKey("See", lang) @LM.GetLocalOrKey("Details", lang)</a>
                <a asp-page="/Dashboard" asp-route-canShowComments="true" class="btn btn-info m-4">@LM.GetLocalOrKey("Comments", lang)</a>
            </span>
            @if (Model.CanShowComments)
            {
                @if (Model.UserComments.Any())
                {
                    <div class="m-2">
                        @for (int i = 0; i < Model.UserComments.Length; i++)
                        {
                            int curentI = i;
                            Comment comment = Model.UserComments[curentI];

                            <div class="m-2">
                                <vc:render-comment comment="@comment" />
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="m-2 text-warning">You dont have any comment yet.</p>
                }
            }

        </div>
    </div>
</div>