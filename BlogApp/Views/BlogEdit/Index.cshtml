@inject ILogger< PaginateItemsViewModel<Blog>> Logger
@inject UrlLocator urlLocator
@model PaginateItemsViewModel<Blog>
@{
    const int MAX_CONTENT_LENGTH = 30;
    Layout = "_HomeLayout";
    ViewBag.Title = "List of user Blog";
    TempData["ReturnUrl"] = Html.ViewContext.HttpContext.Request.Path.ToUriComponent() + Html.ViewContext.HttpContext.Request.QueryString.ToString();
}

<div class="container-md">
    <div class="row bg-white align-items-center">
        <h1 class="col-12 bg-warning text-black text-center">My Blogs</h1>
    </div>
    <div class="row row-cols-md-1 bg-light">
        <h3 class="bg-secondary text-light text-center">List of all Blogs:</h3>
        <div class="m-2 bg-info bg-opacity-50 border border-2 border-info">
            <p class="m-2"> - Blogs that are public and confirmed by admins, shows to public.</p>
            <p class="m-2"> - Editing a confirmed Blog, change its confirmed state to false.</p>
        </div>
   
        <table class="table table-bordered table-hover">
            <thead>
                <tr class="fa-bold">
                    <th>Title</th>
                    <th>Content</th>
                    <th>Is Confirmed?</th>
                    <th>Is Public?</th>
                    <th>Creation Date</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.SelectedItems.Length != 0)
                    @for (int i = 0; i < Model.SelectedItems.Length; i++)
                    {
                        <tr>                          
                            <td>@Model.SelectedItems[i].Title</td>
                            <td>@(Model.SelectedItems[i].BlogContent.Length > MAX_CONTENT_LENGTH ? Model.SelectedItems[i].BlogContent[0..MAX_CONTENT_LENGTH] + " ..." : Model.SelectedItems[i].BlogContent)</td>
                            <td class="align-self-center"><img src="@urlLocator.Images.Static.GetBooleanIcon(Model.SelectedItems[i].IsConfirmed)" alt="Checked" /></td>
                            <td class="align-self-center"><img src="@urlLocator.Images.Static.GetBooleanIcon(Model.SelectedItems[i].IsPublic)" alt="Checked" /></td>
                            <td>@Model.SelectedItems[i].CreationDateTime.ToString()</td>
                            <td>
                                <span>
                                    <a class="btn btn-outline-info m-1" asp-action="Read" asp-route-id="@Model.SelectedItems[i].BlogId">Details</a>
                                    <a class="btn btn-outline-success m-1" asp-action="Update" asp-route-id="@Model.SelectedItems[i].BlogId">Update</a>
                                    <form method="post" asp-action="Delete">
                                        <input hidden name="id" value="@Model.SelectedItems[i].BlogId" />
                                        <button class="btn btn-outline-danger m-1" type="submit">Delete</button>
                                    </form>
                                </span>
                            </td>
                        </tr>
                    }
                else
                {
                    <tr><td class="text-center text-danger">List is empty</td></tr>
                }
            </tbody>
        </table>
    </div>
    <div class="row align-items-center m-2">
        <div class="col"> </div>
        <div class="col-auto m-2">
            <vc:pagination-action controller="BlogEdit" action="Index" page-size="@Model!.PageSize" current-page="@Model.CurrentPage" total-item-count="@Model.AllItemsCount" />
        </div>
        <div class="col"> </div>
    </div>
    <div class="row bg-white align-items-center m-2">
        <div class="col-5"></div>
        <div class="col m-2"><a class="btn btn-outline-primary" asp-action="Create">Create new Blog</a></div>
        <div class="col-5"></div>
    </div>
</div>

