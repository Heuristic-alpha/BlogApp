@model EditBlogViewModel
@inject LocalManager LM
@{
    Layout = "_HomeLayout";
    ViewBag.Title = "Edit Blog";
    Language lang = Html.ViewContext.HttpContext.GetCurrentLanguage();
}

<partial name="_JqueryValidation" />

<div class="container p-2">
    <div class="row">
        <h2 class="col bg-info text-secondary text-center text-black align-content-center">@LM.GetLocalOrKey("Edit", lang) @LM.GetLocalOrKey("Blog", lang)</h2>
    </div>
    <div class="row">
        <div class="col text-danger" asp-validation-summary="ModelOnly"></div>
    </div>
    <div class="row text-black align-items-center container">
        <form asp-action="Update" method="post" id="form">                      
            <input hidden asp-for="@Model.Blog.BlogId" />                     
            <input hidden asp-for="@Model.Blog.AppUserId" />
            <input hidden asp-for="@Model.Blog.CreationDateTime" />
           
            <div class="col form-control m-2">
                <label>@LM.GetLocalOrKey("Title", lang)</label>
                <span class="text-danger" asp-validation-for="@Model.Blog.Title"></span>
                <input class="input-group-text form-text" asp-for="@Model.Blog.Title" />
            </div>
            <div class="col form-control m-2">
                <label>@LM.GetLocalOrKey("Content", lang)</label>
                <span class="text-danger" asp-validation-for="@Model.Blog.BlogContent"></span>
                <textarea class="form-control-plaintext input-group-text text-start" asp-for="@Model.Blog.BlogContent"></textarea>
            </div>
            <div class="col form-control m-2">
                <label>@LM.GetLocalOrKey("Is Confirmed", lang)? (@LM.GetLocalOrKey("Only admins can confirm - editing a confirmed blog or change this property to false", lang))</label>
                <input asp-for="@Model.Blog.IsConfirmed" disabled/>
            </div>
            <div class="col form-control m-2">
                <label>@LM.GetLocalOrKey("Is Public", lang)?</label>
                <input asp-for="@Model.Blog.IsPublic" />
            </div>
            <div class="col form-control m-2">
                <h4 class="m-2 bg-primary text-black text-center">@LM.GetLocalOrKey("Categories", lang)</h4>
                <div class="m-2 bg-secondary bg-opacity-25">
                    @if (Model.CategoryNames.Any())
                    {
                        @for (int i = 0; i < Model.CategoryNames.Count(); i++)
                        {
                            int ii = i;
                            <span class="m-3 bg-white text-black text-center border border-1 border-info">
                                <label class="m-2">@Model.CategoryNames[ii]</label>
                                <input class="m-2" asp-for="@Model.CategoriesValue[ii]" />
                            </span>
                        }
                    }
                    else
                    {
                        <p class="text-danger">There is no categories</p>
                    }
                </div>
            </div>
        </form>
    </div>
    <div class="row m-2 p-2 align-content-center">
        <div class="col"></div>
        <div class="col">
            <a class="btn btn-outline-secondary" href="@(Url.Content((string?)TempData["ReturnUrl"] ?? "BlogEdit/Index"))">@LM.GetLocalOrKey("Back", lang)</a>
            <button class="btn btn-outline-primary" form="form" type="submit">@LM.GetLocalOrKey("Edit", lang)</button>
        </div>
        <div class="col"></div>
    </div>
</div>

