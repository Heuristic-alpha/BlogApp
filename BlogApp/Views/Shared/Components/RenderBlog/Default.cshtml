@using BlogApp.Infrastructures
@using BlogApp.Models
@using BlogApp.Models.Enums
@using BlogApp.Models.JoinModels
@using BlogApp.ViewModels
@using Microsoft.AspNetCore.Identity
@model Blog
@inject UserProfilePictureService profilePictureService
@inject LocalManager LM
@{
    IdentityAppUser? identityAppUser = Html.ViewContext.HttpContext.GetIdentityAppUser();
    string[] lines = Model.BlogContent.Split('\n', StringSplitOptions.None);

    string[] categories = null!;
    if(TempData.TryGetValue("Categories", out object? value1))
    {
        categories = (string[])value1!;
    }

    AppUserBlog? currentAppUserBlog = null;
    if (TempData.TryGetValue("CurrentAppUserBlog", out object? value2))
    {
        currentAppUserBlog = (AppUserBlog)value2!;
    }

    Language lang = Html.ViewContext.HttpContext.GetCurrentLanguage();   
}

@if (@Model == null)
{
    <div class="bg-black text-danger">
        Blog is null
    </div>
}
else
{
    <div class="container">
        <div class="row m-2">
            <div class="col-1"></div>
            <div class="col m-2 bg-secondary bg-opacity-25 border border-2 border-primary">
                <h2 class="m-2 text-center text-black bg-warning bg-opacity-50">@Model.Title</h2>
                <div class="m-2 bg-info bg-opacity-25">
                    <img class="m-2" src="@Url.Content(profilePictureService.GetProfilePictureURL(Model.AppUser!))" alt="User Icon" width="64" height="64" />
                    @LM.GetLocalOrKey("Authored by", lang) <a asp-page="/Profile/View" asp-route-id="@Model.AppUserId" class="text-danger">@Model.AppUser?.DisplayName</a> @LM.GetLocalOrKey("at", lang) <span class="text-success">@Model.CreationDateTime.ToString()</span>
                </div>
                <div class="m-2 bg-light border border-2 border-secondary">
                    @foreach (string line in lines)
                    {
                        <p class="m-2 text-black">@line</p>
                    }
                </div>
                @if (categories != null && categories.Any())
                {
                    <div class="m-2 bg-info bg-opacity-25">
                        @LM.GetLocalOrKey("Categories", lang):
                        @foreach (string cat in categories)
                        {
                            <span class="m-2 bg-info text-black text-center border border-1 border-white">@cat</span>
                        }
                    </div>
                }
                <div class="m-2 bg-warning bg-opacity-25 border border-1 border-success align-items-center text-center">
                    <span class="text-dark">@LM.GetLocalOrKey("Do you like this blog?", lang)</span>
                    @if(identityAppUser != null)
                    {
                        <form method="post" asp-controller="BlogEdit" asp-action="VoteAndReload">
                            <input hidden name="BlogId" value="@Model.BlogId" />
                            <input hidden name="AppUserId" value="@identityAppUser.AppUserId" />
                            <input hidden name="VoteType" value="@(currentAppUserBlog != null ? Reverse(currentAppUserBlog.VoteType) : VoteType.Like)" />
                            <input hidden name="ReturnUrl" value="@Html.ViewContext.HttpContext.Request.GetPathWithQuery()" />
                            <button class="m-2 btn">
                                <img src="@GetHeartIcon(currentAppUserBlog)" alt="Heart icon" width="32" height="32" />
                            </button>
                        </form>
                    }
                    else
                    {
                        <span>@LM.GetLocalOrKey("login to vote", lang)</span>
                    }
                    <span class="text-danger m-2">@LM.GetLocalOrKey("Like", lang) (@Model.Like)</span>
                </div>
            </div>
            <div class="col-1"></div>
        </div>
        <div class="row m-2">
            <div class="col-1"></div>
            <div class="col m-2 bg-success bg-opacity-25 border border-2 border-success">
                @if(identityAppUser == null)
                {
                    <p>- @LM.GetLocalOrKey("Logined user can post commnts on this blog", lang). </p>
                    <a class="text-primary" asp-page="/Account/Login">@LM.GetLocalOrKey("Login", lang)</a>
                }
                else
                {
                    if (currentAppUserBlog != null && currentAppUserBlog.CommentId != null)
                    {
                        <p class="m-2">- @LM.GetLocalOrKey("Dear user, you have already a comment on this blog. You cant add new comment anymore.", lang)</p>
                    }
                    else
                    {
                        @* Write new comment *@
                        <label class="m-2 text-primary">@LM.GetLocalOrKey("New Comment", lang):</label>
                        <form method="post" asp-controller="CommentOperation" asp-action="AddAndReload">
                            <input hidden name="BlogId" value="@Model.BlogId" />
                            <input hidden name="AppUserId" value="@(identityAppUser?.AppUserId ?? 0)" />
                            <input hidden name="ReturnUrl" value="@Context.Request.GetPathWithQuery()" />
                            <textarea class="m-2 form-control-plaintext input-group-text text-start bg-white text-dark" name="Text"></textarea>
                            <button class="btn btn-outline-dark m-2">@LM.GetLocalOrKey("Add", lang)</button>
                        </form>
                    }
                }
            </div>
            <div class="col-1"></div>
        </div>
              
        <div class="row m-2">
            <div class="col-2"></div>
            <div class="col m-2 bg-success bg-opacity-25 border border-2 border-success">
                <h4 class="m-2 text-center text-black bg-primary bg-opacity-50">@LM.GetLocalOrKey("Comments", lang)</h4>
                @if (Model.Comments != null && Model.Comments.Any())
                {
                    @foreach (var c in Model.Comments)
                    {
                        <vc:render-comment comment="c" can-add-like="true" />        
                    }
                }
                else
                {
                    <p>- @LM.GetLocalOrKey("No comment yet", lang).</p>
                }
            </div>
            <div class="col-2"></div>
        </div>
    </div>
}

@functions
{
    public string GetHeartIcon(AppUserBlog? appUserBlog)
    {       
        if (appUserBlog != null && appUserBlog.VoteType == BlogApp.Models.Enums.VoteType.Like)
        {
            return Url.Content(Constants.StaticImagesURL.HeartIcon);
        }
        return Url.Content(Constants.StaticImagesURL.UnHeartIcon);
    }

    public VoteType Reverse(VoteType vote)
    {
        return vote == VoteType.Like ? VoteType.Dislike : VoteType.Like;
    }

    // public string GetReturnUrl()
    // {
    //     HttpRequest httpRequest = Html.ViewContext.HttpContext.Request;
    //     return Url.Content(httpRequest.Path.ToUriComponent() + httpRequest.QueryString.ToString());
    // }
}