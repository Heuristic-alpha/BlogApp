@using BlogApp.Infrastructures
@using BlogApp.Models
@using BlogApp.Models.Enums
@using BlogApp.ViewModels
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore

@inject UrlLocator urlLocator
@inject UserProfilePictureService profilePictureService

@model Comment?

@{
    IdentityAppUser? identityAppUser = Html.ViewContext.HttpContext.GetIdentityAppUser();
}

@if (Model == null)
{
    <div class="bg-black text-danger">
        Comment is null
    </div>
}
else
{
    <div class="container border border-info m-1 bg-light">
        <div class="row m-2">
            <div class="col m-2">
                <span>
                    <img src="@Url.Content(profilePictureService.GetProfilePictureURL(Model.AppUser!))" alt="User Icon" width="64" height="64" />
                    <a asp-page="/Profile/View" asp-route-id="@Model.AppUserId" class="text-black">@Model.AppUser?.DisplayName</a>
                </span>               
            </div>         
        </div>
        <div class="row m-2">
            <div class="col">
                <textarea disabled class="form-control-plaintext input-group-text text-start" asp-for="@Model.StringContent"></textarea>
            </div>
        </div>
        <div class="row m-2">
            <div class="col">
                <span class="text-success">
                    <img src="@(urlLocator.Images.Static.GetFaceEmojiIcon(true))" />
                    <label>@Model.Like</label>
                    @if (ViewBag.CanAddLike)
                    {
                        <form method="post" asp-controller="CommentOperation" asp-action="VoteAndReload">
                            <input hidden name="CommentId" value="@Model.CommentId" />
                            <input hidden name="AppUserId" value="@(identityAppUser?.AppUserId ?? 0)" />
                            <input hidden name="VoteType" value="@(VoteType.Like)" />
                            <input hidden name="ReturnUrl" value="@Html.ViewContext.HttpContext.Request.GetPathWithQuery()" />
                            <button class="btn btn-outline-success m-2">Like</button>
                        </form>
                    }
                </span>
                
            </div>
            <div class="col">
                <span class="text-danger">
                    <img src="@(urlLocator.Images.Static.GetFaceEmojiIcon(false))" />
                    <label>@Model.Dislike</label>
                    @if (ViewBag.CanAddLike)
                    {
                        <form method="post" asp-controller="CommentOperation" asp-action="VoteAndReload">
                            <input hidden name="CommentId" value="@Model.CommentId" />
                            <input hidden name="AppUserId" value="@(identityAppUser?.AppUserId ?? 0)" />
                            <input hidden name="VoteType" value="@(VoteType.Dislike)" />
                            <input hidden name="ReturnUrl" value="@Html.ViewContext.HttpContext.Request.GetPathWithQuery()" />
                            <button class="btn btn-outline-danger m-2">Dislike</button>
                        </form>
                    }
                </span>
            </div>
        </div>
    </div>
}

